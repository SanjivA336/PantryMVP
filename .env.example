# Copy this file to .env (repo root) and fill in real values.
# .env is gitignored; never commit real credentials. This example file IS
# committed, so it must only ever hold placeholders and safe defaults.
#
# Who reads this: the backend (backend/app/core/config.py), the frontend
# (Vite, via envDir in frontend/vite.config.ts), and the Supabase CLI. In a
# deployed environment, set the same names as real environment variables on
# the host instead of using a .env file.
#
# Restart the dev servers after any change here; both only read it at startup.

# ============================================================================
# Supabase (Project Settings > API in the Supabase dashboard)
# ============================================================================
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-public-key>
# Bypasses row-level security. Backend only; never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key-KEEP-SECRET>
# Currently unused: the backend verifies login tokens against Supabase's public
# signing keys (JWKS), not this shared secret. Safe to leave out of a deployed
# environment; it's only defined in config.py.
SUPABASE_JWT_SECRET=<jwt-secret-from-Project-Settings-API>

# Read by the Supabase CLI (not the backend) for `npx supabase db push`, `db
# dump` (manual backups) and `link`, so it doesn't prompt every time. This is
# the database password you chose when creating the project; reset it under
# Project Settings > Database if you've lost it.
SUPABASE_DB_PASSWORD=<database-password-KEEP-SECRET>

# Personal access token for the Supabase CLI (non-interactive `supabase link`/`db push`).
# Generate at https://supabase.com/dashboard/account/tokens. Treat it like a password.
SUPABASE_ACCESS_TOKEN=<personal-access-token>

# ============================================================================
# Frontend (Vite only exposes variables with the VITE_ prefix to browser code)
# ============================================================================
# Everything VITE_* is bundled into the public JavaScript, so anyone can read
# it. Only put public values here (the anon key is designed to be public, the
# service-role key and anything marked SECRET above are NOT).
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>
# Where the frontend calls the API. Change to the deployed backend's URL in
# production; it also has to be allowed in the backend's CORS list (main.py).
VITE_API_BASE_URL=http://localhost:8000

# ============================================================================
# Environment label
# ============================================================================
# Tags backend error reports in Sentry (the frontend uses Vite's own mode, so
# it labels itself). "development" locally; set to "production" on the
# deployed backend so real user errors can be told apart from local noise.
ENVIRONMENT=development

# ============================================================================
# CORS (which websites may call this API from a browser)
# ============================================================================
# Comma-separated origins (scheme + host, no path or trailing slash). Defaults
# to the local Vite dev servers, so leave it unset for local development. A
# deployed backend must list the real frontend origin, e.g.
# CORS_ORIGINS=https://burrowapp.site
# A wrong or missing value shows up as a CORS error in the browser console, not
# as an error on the server. Backend only.
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ============================================================================
# Error tracking (Sentry) -- two separate Sentry projects, one per side
# ============================================================================
# Create at https://sentry.io, then copy each project's DSN from Settings >
# Projects > <project> > Client Keys. Use a FastAPI project for the backend and
# a React project for the frontend, so each gets its own DSN. A DSN only lets
# you send errors in (it can't read anything), and the frontend one ships in
# the public bundle anyway, but keep both out of git.
# Blank means error tracking is simply off: both sides no-op without one, so
# no account is needed for local dev.
SENTRY_DSN=
VITE_SENTRY_DSN=

# ============================================================================
# Support contact (frontend/src/components/SupportLink.tsx)
# ============================================================================
# Where "Contact support" goes -- a Google Form link works fine. Shown in the
# desktop sidebar, the Burrow settings tab and the Account page. Blank hides
# the link everywhere rather than showing one that goes nowhere.
# Public (VITE_), so use the form's shareable respond link, not its edit link.
VITE_SUPPORT_URL=

# ============================================================================
# Password reset / confirmation email (Resend)
# ============================================================================
# Only used by supabase/config.toml's [auth.email.smtp] block, i.e. the LOCAL
# Supabase CLI stack. The hosted project sends its own emails using SMTP
# settings entered separately in the Supabase Dashboard (Authentication >
# Emails > SMTP Settings); paste the same Resend values in there directly.
# Get a key at https://resend.com/api-keys. Real users need a verified sending
# domain (not just your own Resend account address).
RESEND_API_KEY=

# ============================================================================
# Developer allowlist (backend/app/core/auth.py, frontend nav/route gating)
# ============================================================================
# Comma-separated Supabase auth user ids (Dashboard > Authentication > Users,
# the "UID" column). AI/OCR-backed features (recipe generate,
# import-by-text-or-url, substitutions, receipt scanning) are gated to this
# list -- real inference/OCR cost, still experimental. The backend enforces
# DEVELOPER_USER_IDS; the VITE_ copy only hides the UI, so keep them identical.
DEVELOPER_USER_IDS=
VITE_DEVELOPER_USER_IDS=

# ============================================================================
# Receipt scanning OCR (backend/app/core/config.py)
# ============================================================================
# "google_vision" is the only engine implemented; without a key, receipt
# scanning still works end-to-end but every session ends in a clean FAILED
# state instead of extracting line items.
OCR_ENGINE=google_vision
# Enable the Cloud Vision API and create a key at
# https://console.cloud.google.com/apis/credentials (APIs & Services > Credentials).
GOOGLE_VISION_API_KEY=

# ============================================================================
# Recipe AI (backend/app/core/config.py)
# ============================================================================
# "ollama" is the only provider implemented. Defaults below assume
# `ollama serve` running locally with the model already pulled
# (`ollama pull llama2`); change OLLAMA_BASE_URL if it's running elsewhere.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2
# Optional, shown at their defaults. A cold-started local model can take
# 40-70s on CPU, so the timeout is deliberately long. The retry flag is a plain
# on/off switch for one repair attempt on a malformed AI response.
# AI_REQUEST_TIMEOUT_SECONDS=120
# AI_RETRY_ENABLED=true

# ============================================================================
# API rate limiting (backend/app/core/rate_limit.py)
# ============================================================================
# Per-client-IP cap on the /api surface; both optional, shown here at their
# defaults. Auth (signup/login/password reset) goes straight from the
# frontend to Supabase Auth and is never subject to this.
# RATE_LIMIT_MAX_REQUESTS=120
# RATE_LIMIT_WINDOW_SECONDS=60
