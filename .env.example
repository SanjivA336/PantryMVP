# Copy this file to .env (repo root) and fill in real values.
# .env is gitignored; never commit real credentials.

# --- Supabase project settings (Project Settings > API in the Supabase dashboard) ---
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-public-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key-KEEP-SECRET>
SUPABASE_JWT_SECRET=<jwt-secret-from-Project-Settings-API>

# Personal access token for the Supabase CLI (non-interactive `supabase link`/`db push`).
# Generate at https://supabase.com/dashboard/account/tokens. Treat it like a password.
SUPABASE_ACCESS_TOKEN=<personal-access-token>

# --- Frontend (Vite requires the VITE_ prefix to expose these to client code) ---
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>
VITE_API_BASE_URL=http://localhost:8000

ENVIRONMENT=development

# --- Receipt scanning OCR (backend/app/core/config.py) ---
# "google_vision" is the only engine implemented; without a key, receipt
# scanning still works end-to-end but every session ends in a clean FAILED
# state instead of extracting line items.
OCR_ENGINE=google_vision
# Enable the Cloud Vision API and create a key at
# https://console.cloud.google.com/apis/credentials (APIs & Services > Credentials).
GOOGLE_VISION_API_KEY=

# --- Recipe AI (backend/app/core/config.py) ---
# "ollama" is the only provider implemented. Defaults below assume
# `ollama serve` running locally with the model already pulled
# (`ollama pull llama2`); change OLLAMA_BASE_URL if it's running elsewhere.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# --- API rate limiting (backend/app/core/rate_limit.py) ---
# Per-client-IP cap on the /api surface; both optional, shown here at their
# defaults. Auth (signup/login/password reset) goes straight from the
# frontend to Supabase Auth and is never subject to this.
# RATE_LIMIT_MAX_REQUESTS=120
# RATE_LIMIT_WINDOW_SECONDS=60

# --- Password reset email (Resend) ---
# Used by supabase/config.toml's [auth.email.smtp] block for the local CLI
# stack. The linked hosted project's own password-reset emails are
# configured separately, in the Supabase Dashboard for that project
# (Authentication > Settings > SMTP Settings) -- paste the same Resend
# values in there directly. Get a key at https://resend.com/api-keys
# (needs a verified sending domain before it can email real users, not
# just your own Resend account address).
RESEND_API_KEY=

# --- Error tracking (Sentry) ---
# Get a DSN at https://sentry.io (Settings > Projects > <project> > Client
# Keys). Blank means error tracking is simply off -- both the backend and
# frontend no-op without one, no account needed for local dev.
SENTRY_DSN=
VITE_SENTRY_DSN=

# --- Support contact (frontend/src/pages/account/AccountPage.tsx) ---
# Wherever support requests should go -- a Google Form link works fine.
# Blank hides the "Contact support" link entirely rather than showing one
# that goes nowhere.
VITE_SUPPORT_URL=

# --- Developer allowlist (backend/app/core/auth.py, frontend nav/route gating) ---
# Comma-separated Supabase auth user ids. AI/OCR-backed features (recipe
# generate, import-by-text-or-url, substitutions, receipt scanning) are
# gated to this list -- real inference/OCR cost, still experimental.
DEVELOPER_USER_IDS=
VITE_DEVELOPER_USER_IDS=
